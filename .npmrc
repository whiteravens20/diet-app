# Supply-chain hardening (mirrors archivum-null).
# Block install/postinstall scripts — opt in per-package only when audited.
ignore-scripts=true
# NOTE: `min-release-age` (release quarantine) is intentionally NOT set — with
# this npm version it breaks dependency resolution against the newest releases
# this project pins. Supply-chain hardening still relies on `ignore-scripts`,
# `npm audit signatures` and Trivy/CodeQL in CI. Revisit when npm fixes it.
save-exact=true
