# Supply-chain hardening.
# Block install/postinstall scripts — opt in per-package only when audited.
ignore-scripts=true

# Refuse to resolve a version published less than 7 days ago. This is the
# backstop: it fires at resolution (`npm install`, `npm update`), not on
# `npm ci`, which installs exactly what the lockfile already pins. Dependabot
# is held back upstream by `cooldown` in .github/dependabot.yml.
min-release-age=7

# Registry signatures are verified by `npm audit signatures` in
# .github/workflows/security.yml. `audit-signatures` is a flag on `npm audit`,
# not an npmrc key, so it does not belong here.
save-exact=true
