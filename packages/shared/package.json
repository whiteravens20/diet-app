{
  "name": "@diet-app/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Zod schemas and types — the Diet App API contract.",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./options": {
      "import": {
        "types": "./dist/esm/options.d.ts",
        "default": "./dist/esm/options.js"
      },
      "require": {
        "types": "./dist/options.d.ts",
        "default": "./dist/options.js"
      }
    },
    "./units": {
      "import": {
        "types": "./dist/esm/units.d.ts",
        "default": "./dist/esm/units.js"
      },
      "require": {
        "types": "./dist/units.d.ts",
        "default": "./dist/units.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/mark-esm.mjs",
    "dev": "tsc -b tsconfig.json tsconfig.esm.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
