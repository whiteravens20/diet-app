# ──────────────────────────────────────────────────────────────────────────────
# Diet App — environment configuration
# Do not copy this file by hand: run `sh scripts/init-env.sh`. It writes `.env`
# from this template with freshly generated secrets. `.env` is gitignored.
# See docs/ops/env-reference.md.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public origin the web app is served from (used for CORS + links).
APP_URL=http://localhost:3000
# Public origin the API is reachable at.
API_URL=http://localhost:4000
# Interactive API documentation at /api/docs. Blank: on in development, off
# in production. `true` or `false` decides for both.
SWAGGER_ENABLED=
# Where the curated data lives. Blank: the `data/` directory of the repository
# (or of the image). Set it only for a non-standard layout.
SEED_DATA_DIR=

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Dev defaults are intentionally simple. CHANGE THE PASSWORD for any real deploy.
POSTGRES_USER=diet
POSTGRES_PASSWORD=diet
POSTGRES_DB=diet_app
# Host `localhost` for `npm run dev`; use host `postgres` inside Docker Compose.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public

# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs user access tokens. Left blank here on purpose: the API refuses to start
# without a random value of 32+ characters. `sh scripts/init-env.sh` fills it
# in; to replace it later: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900            # seconds (15 min)
JWT_REFRESH_TTL=2592000       # seconds (30 days)
# Secret for the translation-reviewer cookie. Optional: when blank, a key is
# derived from DATA_ENCRYPTION_SECRET, so the cookie never shares a key with
# user access tokens. Set a value of its own (openssl rand -hex 32) to be able
# to rotate reviewer sessions separately.
REVIEWER_SESSION_SECRET=
# bcrypt cost factor.
PASSWORD_HASH_ROUNDS=12

# ── Encryption secrets ────────────────────────────────────────────────────────
# Both are 32 random bytes = 64 hex chars, and they must differ. Left blank here
# on purpose: the API refuses to start without them. `sh scripts/init-env.sh`
# fills them in.
#
# AES-256-GCM key for encrypting per-user AI provider keys at rest.
AI_KEY_ENCRYPTION_SECRET=
# Master secret for encrypting user PII (email) at rest and peppering password
# hashes. CHANGING THIS makes existing accounts unreadable — set it once and
# back it up with the database.
DATA_ENCRYPTION_SECRET=

# ── AI provider defaults (admin-level fallback) ───────────────────────────────
# Used when a user has not configured their own provider. Leave blank to force
# the deterministic engine. Provider: openai | anthropic | openrouter | ollama
AI_DEFAULT_PROVIDER=ollama
AI_DEFAULT_MODEL=llama3.1:8b
# Admin-supplied keys (optional). Per-user BYOK keys are stored encrypted in DB.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Ollama base URL — the compose `ollama` service, or any reachable instance.
OLLAMA_BASE_URL=http://ollama:11434
# Whether users may point their own BYOK Ollama config at a host of their choice
# (SSRF guard — a user-supplied host is otherwise an open door into your network):
#   off       users cannot configure Ollama; only OLLAMA_BASE_URL (above) serves
#             admin-mode users. Pick this if you don't want user Ollama at all.
#   allowlist (default) users may only use OLLAMA_BASE_URL's host or a host listed
#             in OLLAMA_ALLOWED_HOSTS below. Safest "let some users in" option.
#   public    users may use ANY host except internal/private/loopback addresses.
#             This restores full BYOK liberty (a user's own public Ollama works),
#             but note: the server will then make outbound requests to whatever
#             public host the user names. That only ever carries that user's own
#             prompt to a server they chose, and every AI response is re-validated
#             and recomputed by the deterministic engine — but if you don't want
#             your instance dialling arbitrary external hosts, keep `allowlist`.
OLLAMA_USER_POLICY=allowlist
# Extra hosts permitted when OLLAMA_USER_POLICY=allowlist. Comma-separated,
# `host` or `host:port`. OLLAMA_BASE_URL's host is always allowed implicitly.
OLLAMA_ALLOWED_HOSTS=
# Per-user monthly quota for users on `aiMode='admin'` (rolling 30 days).
# Only calls the provider completed are counted. BYOK users have no quota;
# `none` users never make AI calls. Set to 0 to refuse admin-mode for everyone
# without unsetting AI_DEFAULT_PROVIDER.
AI_ADMIN_USER_MONTHLY_LIMIT=40
# The same window for all users together: the most your provider is asked for
# in 30 days, however many accounts there are. Raise it for a larger instance.
AI_ADMIN_INSTANCE_MONTHLY_LIMIT=1000

# ── Cloudflare Turnstile (optional anti-abuse) ────────────────────────────────
# Leave TURNSTILE_ENABLED=false for self-hosted deployments without Turnstile.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limiting (always on, independent of Turnstile) ───────────────────────
RATE_LIMIT_WINDOW=60          # seconds, applies to every endpoint
RATE_LIMIT_MAX=120            # requests/window/IP global default
# AI + plan-generation endpoints carry their own fixed, tighter per-route
# limits (recipe draft 10, plan (re)generate 20, AI swap 30, provider test 20
# per minute) — these are not operator-tunable.

# ── Email (password reset, optional verification) ─────────────────────────────
# Leave SMTP_HOST blank to run without mail. The web app then does not offer
# password reset. A reset requested straight from the API is written to the API
# log outside production and dropped in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@diet-app.local

# ── Ports (host-side) ─────────────────────────────────────────────────────────
# Host-side port bindings only — change to avoid collisions on your host (e.g.
# if 3000 is already taken). Inside the containers the ports are always 3000
# (web) and 4000 (api): both Compose files pin the API's own port, so API_PORT
# here only chooses the host side of the mapping. The default prod compose does
# not publish the API to the host at all; API_PORT takes effect there only if
# you add a `ports:` block to the api service for a companion-app subdomain.
# Outside Docker (`npm run dev`), API_PORT is the port the API listens on.
WEB_PORT=3000
API_PORT=4000

# ── Production deploy (infra/docker-compose.prod.yml) ─────────────────────────
# Tag of the GHCR image to pull. `latest` follows the production release
# channel; pin to a specific release tag for stable deploys and bump after
# testing. Ignored by the dev compose files (they build locally).
IMAGE_TAG=latest

# ── Admin panel  ──────────────────────────────────────────────────────────────
# Basic-auth credentials for /admin and /api/admin/*. Disabled by default:
# leaving ADMIN_PASSWORD empty or set to the placeholder below makes every
# admin route return 403 (fail-closed).
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# ── Curation-queue ship mechanism ──────────────────────────────────
# The curation queue ships approved drafts to one of three targets, picked per
# action from the admin UI:
#   - local        approved rows land directly in the live DB tables with
#                  source=MANUAL (so they survive every re-seed). A sidecar
#                  JSON file is dropped under INSTANCE_DATA_DIR (gitignored)
#                  as a portable backup. This is the default for self-hosters.
#   - upstream-pr  opens a gh-CLI pull request against SHIP_UPSTREAM_REMOTE.
#                  Disabled by default; ONLY enable on the maintainer's clone
#                  of the canonical diet-app repo, never on a self-hoster
#                  instance — the canonical baseline lives under maintainer
#                  review.
#   - zip          downloads a one-shot signed bundle of the approved rows.
#                  Always available as a universal fallback.
INSTANCE_DATA_DIR=instance-data
SHIP_UPSTREAM_ENABLED=false
SHIP_UPSTREAM_REMOTE=origin
SHIP_UPSTREAM_BASE_BRANCH=main
# gh CLI auth token used for `gh pr create`. Leave blank when upstream-pr mode
# is disabled.
SHIP_UPSTREAM_GH_TOKEN=
# Author identity for the commit that lands the batch. Falls back to the
# host's git config when blank.
SHIP_UPSTREAM_GIT_AUTHOR_NAME=
SHIP_UPSTREAM_GIT_AUTHOR_EMAIL=
# NOTE: pushing AI-drafted content to the canonical whiteravens20/diet-app
# repository is hard-disabled at runtime, with no escape hatch. Even the
# maintainer's own instance keeps generated content in a private mirror —
# canonical-baseline edits go through normal hand-authored PRs. Set
# SHIP_UPSTREAM_REMOTE to your private mirror's remote name; pointing it at
# the canonical repo returns SHIP_UPSTREAM_BLOCKED_CANONICAL.
# Signs the zip-download one-shot tokens. Blank → JWT_ACCESS_SECRET is reused.
SHIP_DOWNLOAD_TOKEN_SECRET=
# "Pull ingredient overrides from a repo" — the reverse of the local ship. The
# admin panel fetches a repo's data/ingredient-overrides.json and applies it to
# the live DB as source=MANUAL, so you can sync friendly ingredient names
# authored elsewhere (or the community set) without rebuilding. The operator
# types the repo in the UI; this is only the default prefill. Accepts an
# owner/repo[@branch] (GitHub) or a full raw URL (e.g. gitea/gitlab).
OVERRIDES_PULL_SOURCE=whiteravens20/diet-app
# PAT for pulling from a PRIVATE repo. Only ever sent to GitHub hosts. Blank →
# falls back to SHIP_UPSTREAM_GH_TOKEN, then public-only.
OVERRIDES_PULL_TOKEN=

# ── USDA FoodData Central importer (build-time, optional) ─────────────────────
# Used by `npm run import:usda` to populate `data/ingredients.generated.json`.
# Get a free key at https://api.data.gov/signup (1000 req/hr). Leave blank to
# use FDC's public DEMO_KEY (30 req/hr — only viable for Foundation alone).
FDC_API_KEY=
# Comma-separated FDC dataTypes. 'Foundation' alone is ~340 foods; add
# 'SR Legacy' for ~8k. A real FDC_API_KEY is required for the larger import.
FDC_DATA_TYPES='Foundation'

# ── What the instance publishes about itself (optional) ──────────────────────
# Served by GET /api/config and read by the web app at run time: a change needs
# a restart of the API, not a rebuild of the web app.
#
# Where the footer's "Support us" link points. Forks can repoint it to their
# own funding page. Blank → the project's own page.
SUPPORT_URL=
# E-mail address of whoever runs this instance, shown on /terms §10. Blank →
# the page says that the operator has not published one.
OPERATOR_CONTACT=
# Version label in the footer. Blank → the version of the package that is
# running. Set it to show a release tag or a commit id instead.
APP_VERSION=
