{
  "name": "diet-app",
  "version": "0.19.0",
  "private": true,
  "description": "Self-hostable diet & meal-planning platform with deterministic nutrition and BYOK AI.",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "author": "White Ravens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiteravens20/diet-app.git"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "data:lint": "npm run data:lint -w apps/api",
    "test:catalogue": "npm run test:catalogue -w apps/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "husky": "9.1.7",
    "prettier": "^3.4.2",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@hono/node-server": "^1.19.13",
    "next": {
      "postcss": "^8.5.10"
    }
  }
}
