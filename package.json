{
  "name": "diet-app",
  "version": "0.77.0",
  "private": true,
  "description": "Self-hostable diet & meal-planning platform with deterministic nutrition and BYOK AI.",
  "license": "AGPL-3.0-only",
  "author": "White Ravens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiteravens20/diet-app.git"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "check:docs": "node scripts/check-doc-links.mjs",
    "knip": "knip",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "data:lint": "npm run data:lint -w apps/api",
    "bench": "npm run bench -w apps/api",
    "contract": "npm run contract -w apps/api",
    "test:catalogue": "npm run test:catalogue -w apps/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.4",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "multer": "^2.2.0",
    "js-yaml": "^4.2.0",
    "mysql2": "^3.23.1",
    "deepmerge-ts": "^8.0.0",
    "vite": "^8.2.4",
    "next": {
      "postcss": "^8.5.10"
    }
  }
}
