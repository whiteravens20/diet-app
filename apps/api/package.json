{
  "name": "@diet-app/api",
  "version": "0.0.0",
  "private": true,
  "description": "Diet App backend — NestJS REST API, deterministic engine, AI orchestration, BullMQ worker.",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:catalogue": "vitest run src/common/error-catalogue.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "data:lint": "tsx scripts/validate-data.ts",
    "import:usda": "tsx scripts/import-usda.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@diet-app/shared": "*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.78.0",
    "ioredis": "^5.11.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "9.0.4",
    "ollama": "^0.6.3",
    "openai": "^6.42.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.4",
    "eslint": "^9.39.5",
    "fast-check": "^4.9.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
