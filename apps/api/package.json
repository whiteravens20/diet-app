{
  "name": "@diet-app/api",
  "version": "0.0.0",
  "private": true,
  "description": "Diet App backend — NestJS REST API, deterministic engine, AI orchestration, scheduled-tasks worker.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:catalogue": "vitest run src/common/error-catalogue.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "data:lint": "tsx scripts/validate-data.ts",
    "import:usda": "tsx scripts/import-usda.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@diet-app/shared": "*",
    "@nestjs/common": "^11.1.25",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.25",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.25",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "nodemailer": "10.0.13",
    "openai": "^6.42.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.22",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.25",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.4",
    "prisma": "^7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
