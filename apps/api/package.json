{
  "name": "@diet-app/api",
  "version": "0.0.0",
  "private": true,
  "description": "Diet App backend — NestJS REST API, deterministic engine, AI orchestration, scheduled-tasks worker.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:cov": "vitest run --coverage --project unit --project integration",
    "bench": "vitest run --project benchmark",
    "contract": "tsx scripts/contract.ts",
    "test:catalogue": "vitest run src/common/error-catalogue.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "data:lint": "tsx scripts/validate-data.ts",
    "import:usda": "tsx scripts/import-usda.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@diet-app/shared": "*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "6.0.0",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "nodemailer": "10.0.11",
    "openai": "^6.42.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@types/bcrypt": "6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.4",
    "supertest": "^7.1.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
