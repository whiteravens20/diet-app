// Diet App data model.
// The product/ingredient + nutrition tables are CURATED SEED DATA and the single
// source of truth for nutrition. AI never writes to them. See docs/architecture.

generator client {
  provider      = "prisma-client-js"
  // `native` for local dev; the musl target is for the Alpine Docker image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  // Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and is
  // passed to PrismaClient via the pg driver adapter (see prisma/prisma.service.ts).
  provider = "postgresql"
}

// ── Accounts & auth ───────────────────────────────────────────────────────────

enum Role {
  user
  admin
}

model User {
  id             String   @id @default(uuid())
  // Email is never stored in plaintext. `emailIndex` is a keyed HMAC (blind
  // index) for unique lookups; `emailEncrypted` is the AES-256-GCM ciphertext
  // of the address. See apps/api/src/common/crypto.ts.
  emailIndex     String   @unique
  emailEncrypted String
  passwordHash   String
  displayName    String
  role           Role     @default(user)
  emailVerified  Boolean  @default(false)
  // ISO 639-1; constrained at the API layer to the Locale enum in packages/shared.
  locale         String   @default("en")
  // 'light' | 'dark' | 'system' — constrained at the API layer.
  theme          String   @default("system")
  // Colour palette family (default | ocean | forest | sunset | mono | rose) —
  // orthogonal to `theme`. Constrained at the API layer via the Palette enum
  // in packages/shared/src/settings.ts.
  palette        String   @default("default")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profiles      Profile[]
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  aiConfigs     AiProviderConfig[]
  aiUsageLogs   AiUsageLog[]
  auditLogs     AuditLog[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Profiles ──────────────────────────────────────────────────────────────────

enum Sex {
  male
  female
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum DietType {
  balanced
  high_protein
  low_carb
  vegetarian
  vegan
  keto
  mediterranean
  custom
}

model Profile {
  id                  String        @id @default(uuid())
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  name                String
  age                 Int
  sex                 Sex?
  heightCm            Float
  weightKg            Float
  activityLevel       ActivityLevel @default(moderate)
  dietType            DietType      @default(balanced)
  // "0.25" | "0.5" | "0.75" | "1.0" — null = maintenance.
  weeklyLossTarget    String?
  // When set, overrides the calculated daily calorie target.
  manualCalorieTarget Int?
  mealCount           Int           @default(3)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  preferences ProfilePreference?
  mealPlans   MealPlan[]
  favorites   Favorite[]

  @@index([userId])
}

model ProfilePreference {
  id                         String   @id @default(uuid())
  profile                    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId                  String   @unique
  favoriteIngredientIds      String[] @default([])
  excludedIngredientIds      String[] @default([])
  allergens                  String[] @default([])
  dislikedFoods              String[] @default([])
  preferredCuisines          String[] @default([])
  // Hard caps for the meal-plan generator's variety enforcement.
  // See ProfilePreferences zod schema in packages/shared for semantics.
  maxConsecutiveDaysSameMeal Int      @default(2)
  maxTimesPerWeekSameMeal    Int      @default(3)
}

// ── Curated product database (SEED DATA — source of truth) ────────────────────

enum ProductCategory {
  vegetables
  fruits
  dairy
  meat
  fish
  grains
  legumes
  nuts_seeds
  fats_oils
  spices
  pantry
  beverages
  other
}

enum Unit {
  g
  ml
  piece
}

// Provenance for translation rows. CURATED_JSON rows are derived from
// data/*.json and re-written on every seed; AI / MANUAL rows survive re-seeds
// so operator-generated translations are not lost when curated data is updated.
enum TranslationSource {
  CURATED_JSON
  AI
  MANUAL
}

model Ingredient {
  id                String          @id @default(uuid())
  // Stable kebab-case identifier from data/*.json. Used by the seeder to upsert
  // rows and by the translation tables to join on. Nullable during the
  // migration window; backfilled then enforced by a follow-up migration.
  slug              String?         @unique
  name              String          @unique
  category          ProductCategory
  canonicalUnit     Unit
  // Nutrition per 100 canonical units. NutritionFact mirrors this 1:1 for
  // explicit auditing / alternate serving sizes.
  caloriesPer100    Float
  proteinPer100     Float
  fatPer100         Float
  carbsPer100       Float
  gramsPerPiece     Float?
  density           Float?
  allergens         String[]        @default([])
  dietCompatibility String[]        @default([])
  tags              String[]        @default([])
  packSize          Float?
  brand             String?
  storageHint       String?

  nutritionFacts       NutritionFact[]
  recipeIngredients    RecipeIngredient[]
  substitutionsFrom    SubstitutionRule[]      @relation("SubFrom")
  substitutionsTo      SubstitutionRule[]      @relation("SubTo")
  translations         IngredientTranslation[]
  ingredientNameDrafts IngredientNameDraft[]

  @@index([category])
}

// Per-locale display strings for an Ingredient. Numeric/structural fields stay
// on Ingredient — only user-facing text is localised. See docs/adr/ for the
// curated-vs-AI translation split.
model IngredientTranslation {
  ingredientId String
  locale       String
  name         String
  storageHint  String?
  source       TranslationSource @default(CURATED_JSON)
  updatedAt    DateTime          @updatedAt
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([ingredientId, locale])
  @@index([locale])
  @@index([source])
}

// Explicit nutrition rows — supports alternate serving sizes and audit trail.
model NutritionFact {
  id           String     @id @default(uuid())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String
  servingLabel String // e.g. "per 100 g", "per slice (28 g)"
  servingGrams Float
  calories     Float
  protein      Float
  fat          Float
  carbs        Float

  @@index([ingredientId])
}

model Allergen {
  id    String @id @default(uuid())
  code  String @unique // gluten | dairy | eggs | ...
  label String
}

model SubstitutionRule {
  id               String     @id @default(uuid())
  fromIngredient   Ingredient @relation("SubFrom", fields: [fromIngredientId], references: [id], onDelete: Cascade)
  fromIngredientId String
  toIngredient     Ingredient @relation("SubTo", fields: [toIngredientId], references: [id], onDelete: Cascade)
  toIngredientId   String
  note             String?

  @@unique([fromIngredientId, toIngredientId])
}

// ── Recipes ───────────────────────────────────────────────────────────────────

enum RecipeOrigin {
  seed
  ai
  user
}

enum Difficulty {
  easy
  medium
  hard
}

model Recipe {
  id                 String       @id @default(uuid())
  // Stable kebab-case identifier for seed-origin recipes; null for user/AI
  // recipes. Used by the seeder + translation tables, same role as Ingredient.slug.
  slug               String?      @unique
  title              String
  description        String
  servings           Int
  mealTypes          String[]     @default([])
  dietTags           String[]     @default([])
  steps              String[]     @default([])
  prepMinutes        Int
  cookMinutes        Int
  difficulty         Difficulty   @default(easy)
  allergens          String[]     @default([])
  origin             RecipeOrigin @default(seed)
  // Per-serving nutrition — DERIVED from ingredients, recomputed on write.
  caloriesPerServing Float        @default(0)
  proteinPerServing  Float        @default(0)
  fatPerServing      Float        @default(0)
  carbsPerServing    Float        @default(0)
  reuseScore         Float        @default(0)
  // Owner is set for `user`-origin recipes; null for seed/ai library recipes.
  createdByUserId    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  ingredients  RecipeIngredient[]
  plannedMeals PlannedMeal[]
  favorites    Favorite[]
  translations RecipeTranslation[]

  @@index([origin])
}

// Per-locale display strings for a Recipe. `steps` is an array because recipe
// steps are an ordered list and translating each step in place is more accurate
// than translating one concatenated blob.
model RecipeTranslation {
  recipeId    String
  locale      String
  title       String
  description String
  steps       String[]          @default([])
  source      TranslationSource @default(CURATED_JSON)
  updatedAt   DateTime          @updatedAt
  recipe      Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, locale])
  @@index([locale])
  @@index([source])
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId     String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String
  quantity     Float
  unit         Unit
  note         String?

  @@index([recipeId])
  @@index([ingredientId])
}

// ── Meal plans ────────────────────────────────────────────────────────────────

enum GenerationMode {
  deterministic
  ai_assisted
}

model MealPlan {
  id             String         @id @default(uuid())
  profile        Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId      String
  startDate      DateTime       @db.Date
  durationDays   Int
  dietType       DietType
  calorieTarget  Int
  generationMode GenerationMode @default(deterministic)
  reuseScore     Float          @default(0)
  createdAt      DateTime       @default(now())

  days          MealPlanDay[]
  shoppingLists ShoppingList[]

  @@index([profileId])
}

model MealPlanDay {
  id            String   @id @default(uuid())
  plan          MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId        String
  date          DateTime @db.Date
  calorieTarget Int

  meals PlannedMeal[]

  @@index([planId])
}

model PlannedMeal {
  id          String      @id @default(uuid())
  day         MealPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId       String
  recipe      Recipe      @relation(fields: [recipeId], references: [id])
  recipeId    String
  mealType    String
  servings    Float       @default(1)
  // Recipe ids previously shown in this slot via the "swap meal" action.
  // The swap picker excludes the union of this array + the current recipeId
  // so repeated clicks advance through fresh candidates instead of cycling
  // between two. Cleared (reset to just the current recipeId) when the pool
  // is exhausted.
  swapHistory String[]    @default([])

  @@index([dayId])
}

// ── Favorites ─────────────────────────────────────────────────────────────────

model Favorite {
  id        String   @id @default(uuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String
  tags      String[] @default([])
  // user preference signal: often used vs. avoid
  sentiment String   @default("favorite") // favorite | often | avoid
  createdAt DateTime @default(now())

  @@unique([profileId, recipeId])
  @@index([profileId])
}

// ── Shopping lists ────────────────────────────────────────────────────────────

model ShoppingList {
  id        String   @id @default(uuid())
  plan      MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId    String
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  createdAt DateTime @default(now())

  items ShoppingListItem[]

  @@index([planId])
}

model ShoppingListItem {
  id                  String          @id @default(uuid())
  list                ShoppingList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId              String
  ingredientId        String
  name                String
  category            ProductCategory
  totalQuantity       Float
  unit                Unit
  alreadyHaveQuantity Float           @default(0)
  estimatedCalories   Float           @default(0)
  checked             Boolean         @default(false)

  @@index([listId])
}

// ── AI configuration & observability ──────────────────────────────────────────

enum AiProviderKind {
  openai
  anthropic
  openrouter
  ollama
}

model AiProviderConfig {
  id             String         @id @default(uuid())
  // Null userId = admin-level default available to everyone.
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  provider       AiProviderKind
  model          String
  // AES-256-GCM ciphertext (iv:tag:data); never returned by the API.
  encryptedKey   String?
  priority       Int            @default(0)
  enabled        Boolean        @default(true)
  isAdminDefault Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
}

model AiUsageLog {
  id                      String   @id @default(uuid())
  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                  String?
  provider                String
  model                   String
  operation               String // recipe_draft | substitution | plan_variation | ...
  promptTokens            Int      @default(0)
  outputTokens            Int      @default(0)
  latencyMs               Int      @default(0)
  success                 Boolean
  fellBackToDeterministic Boolean  @default(false)
  createdAt               DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String // auth.login | profile.update | plan.generate | ...
  entity    String?
  entityId  String?
  // Non-sensitive context only — never store passwords/keys/raw health data.
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ── Curation queue (drafts) ───────────────────────────────────────────────────

// AI proposes, human approves, PR ships. Drafts never reach the live Recipe /
// Ingredient tables — see docs/adr/0008-curation-queue.md.

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
}

enum DraftSource {
  AI
  EXTERNAL
  MANUAL
}

model RecipeDraft {
  id                 String      @id @default(uuid())
  slug               String
  // Locale-keyed JSON: { "en": "Chicken curry", "pl": "Curry z kurczaka" }.
  // Matches data/recipes.json shape; on ship the seeder splits per-locale
  // into RecipeTranslation rows.
  titles             Json
  descriptions       Json
  // Same locale keys; values are string[]: { "en": ["Step 1"], "pl": ["Krok 1"] }.
  steps              Json
  // Locales this draft was generated in / is expected to ship with. Derived
  // from the generation spec's targetLocales; the reviewer-locale gate
  // enforces this.
  locales            String[]
  servings           Int
  mealTypes          String[]    @default([])
  dietTags           String[]    @default([])
  prepMinutes        Int
  cookMinutes        Int
  difficulty         Difficulty  @default(easy)
  // 'simple' | 'medium' | 'complex' — auto-tagged from ingredient/step/time
  // bands by the validator. See plan §D8.
  complexity         String      @default("medium")
  // Engine-recomputed values — never the AI's. See engine/units.ts +
  // engine/nutrition.ts.
  caloriesPerServing Float       @default(0)
  proteinPerServing  Float       @default(0)
  fatPerServing      Float       @default(0)
  carbsPerServing    Float       @default(0)
  allergens          String[]    @default([])
  // [{ slug, quantity, unit, note? }]
  ingredientsJson    Json
  // Derived from localeReviews: APPROVED iff every locale in `locales[]`
  // has an APPROVE row; REJECTED if any has a REJECT; PENDING otherwise;
  // SHIPPED set only by the ship runner.
  status             DraftStatus @default(PENDING)
  source             DraftSource @default(AI)
  batchId            String
  modelUsed          String?
  generatorPrompt    String?
  generationSpec     Json?
  // EXTERNAL only — source URL + license for the imported row.
  provenanceUrl      String?
  provenanceLicense  String?
  shippedPRUrl       String?
  shippedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  localeReviews RecipeDraftLocaleReview[]

  @@index([status])
  @@index([batchId])
  @@index([source])
}

model RecipeDraftLocaleReview {
  id              String      @id @default(uuid())
  draft           RecipeDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId         String
  // ISO 639-1; constrained to the Locale enum at the API layer.
  locale          String
  // 'APPROVE' | 'REJECT' — constrained at the API layer.
  action          String
  // Free-text label captured from the reviewer's session cookie at review
  // time (e.g. "Anna", "PL-reviewer-1"). Audit only.
  reviewedByLabel String
  reason          String?
  reviewedAt      DateTime    @default(now())

  // One current review per (draft, locale); upsert on re-review.
  @@unique([draftId, locale])
  @@index([draftId])
}

model IngredientNameDraft {
  id              String      @id @default(uuid())
  // Nullable so a draft survives ingredient deletion for audit. The seeder
  // resolves overrides by `ingredientSlug` on ship.
  ingredient      Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  ingredientId    String?
  ingredientSlug  String
  // FDC description at draft time — read-only source reference.
  rawDescription  String
  // Locale-keyed JSON: { "name": { "en": "Beef tenderloin", "pl": "Polędwica wołowa" },
  //                      "storageHint"?: { "en": "...", "pl": "..." } }.
  suggestions     Json
  locales         String[]
  status          DraftStatus @default(PENDING)
  source          DraftSource @default(AI)
  batchId         String
  modelUsed       String?
  // Prompt version tag, e.g. "ingredient-namer.v1".
  generatorPrompt String?
  shippedPRUrl    String?
  shippedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  localeReviews IngredientNameDraftLocaleReview[]

  @@index([status])
  @@index([batchId])
  @@index([ingredientSlug])
}

model IngredientNameDraftLocaleReview {
  id              String              @id @default(uuid())
  draft           IngredientNameDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId         String
  locale          String
  action          String
  reviewedByLabel String
  reason          String?
  reviewedAt      DateTime            @default(now())

  @@unique([draftId, locale])
  @@index([draftId])
}

// Singleton runtime configuration owned by the operator and managed from
// /admin. Currently carries the reviewer-interface toggle + password hash
// (Phase H). Pattern mirrors how ADMIN_PASSWORD itself is handled.
model InstanceSettings {
  id                   String   @id @default("singleton")
  reviewerEnabled      Boolean  @default(false)
  // bcrypt hash; cleared (null) when the operator clears the password.
  reviewerPasswordHash String?
  updatedAt            DateTime @updatedAt
}

// ── Seed bookkeeping ──────────────────────────────────────────────────────────

// Tracks the curated DB version that last ran through the seeder. A single
// row keyed by 'data'; `hash` is sha256 of the concatenated seed files. The
// /admin DB-update flow uses it to surface "update available" when the current
// hash of data/*.json differs from what's stored.
model SeedMeta {
  key           String   @id
  hash          String
  seededAt      DateTime
  // Counters captured at the moment of the last successful seed — cheap to
  // surface without re-counting tables on every stats request.
  ingredients   Int      @default(0)
  recipes       Int      @default(0)
  substitutions Int      @default(0)
}
