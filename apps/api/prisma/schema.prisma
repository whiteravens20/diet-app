// Diet App data model.
// The product/ingredient + nutrition tables are CURATED SEED DATA and the single
// source of truth for nutrition. AI never writes to them.

generator client {
  provider      = "prisma-client-js"
  // `native` for local dev; the musl target is for the Alpine Docker image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  // Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and is
  // passed to PrismaClient via the pg driver adapter (see prisma/prisma.service.ts).
  provider = "postgresql"
}

// ── Accounts & auth ───────────────────────────────────────────────────────────

enum Role {
  user
  admin
}

model User {
  id             String   @id @default(uuid())
  // Email is never stored in plaintext. `emailIndex` is a keyed HMAC (blind
  // index) for unique lookups; `emailEncrypted` is the AES-256-GCM ciphertext
  // of the address. See apps/api/src/common/crypto.ts.
  emailIndex     String   @unique
  emailEncrypted String
  passwordHash   String
  displayName    String
  role           Role     @default(user)
  emailVerified  Boolean  @default(false)
  // ISO 639-1; constrained at the API layer to the Locale enum in packages/shared.
  locale         String   @default("en")
  // 'light' | 'dark' | 'system' — constrained at the API layer.
  theme          String   @default("system")
  // Colour palette family (default | ocean | forest | sunset | mono | rose) —
  // orthogonal to `theme`. Constrained at the API layer via the Palette enum
  // in packages/shared/src/settings.ts.
  palette        String   @default("default")
  // Per-user AI mode: 'none' | 'admin' | 'byok'. 'none' is the default
  // so a fresh account never makes outbound AI calls until the user opts in.
  // Constrained at the API layer via the AiMode enum in packages/shared.
  aiMode         String   @default("none")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profiles           Profile[]
  refreshTokens      RefreshToken[]
  resetTokens        PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  emailChangeTokens  EmailChangeToken[]
  aiConfigs          AiProviderConfig[]
  aiUsageLogs        AiUsageLog[]
  recipes            Recipe[]
  secondFactor       SecondFactor?
  signInChallenges   SignInChallenge[]
}

// One refresh token of a session. A session is the chain of tokens that
// follow one another from a sign-in: they share `familyId`, which is the id
// of the session. A token is used once (`rotatedAt`) and the next takes its
// place; the used ones stay for as long as the session does, so that a token
// presented a second time is known for what it is and ends the session.
model RefreshToken {
  id              String    @id @default(uuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  tokenHash       String    @unique
  familyId        String
  // When the session ends, however often it is used.
  familyExpiresAt DateTime
  // What the session was opened from, as far as the request said.
  label           String?
  expiresAt       DateTime
  rotatedAt       DateTime?
  revokedAt       DateTime?
  // When the session passed the second step of signing in. Null for a
  // session of an account that had no second factor when it began.
  secondFactorAt  DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

// The second step of signing in: the secret an authenticator app makes its
// codes from. One for each account that set it up, and one for the
// administrator, which belongs to no account and has the id "administrator".
model SecondFactor {
  id              String         @id @default(uuid())
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?        @unique
  // AES-256-GCM, sealed for whose it is. See apps/api/src/common/crypto.ts.
  secretEncrypted String
  // The time step of the code accepted last: a code is good once.
  lastStep        Int
  // Wrong codes in a row, and until when the next one is not looked at.
  failures        Int            @default(0)
  blockedUntil    DateTime?
  createdAt       DateTime       @default(now())
  recoveryCodes   RecoveryCode[]
}

// A code that stands in for the authenticator app, once. Kept as a keyed
// hash that is bound to the second factor it belongs to.
model RecoveryCode {
  id             String       @id @default(uuid())
  secondFactor   SecondFactor @relation(fields: [secondFactorId], references: [id], onDelete: Cascade)
  secondFactorId String
  codeHash       String
  usedAt         DateTime?

  @@index([secondFactorId])
}

// What an account with a second factor holds between its password and its
// code: proof that the password was right, good for one sign-in and a few
// minutes. Kept as a hash.
model SignInChallenge {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One-time token emailed at registration (and on resend) to confirm the user
// owns the address. Only created when SMTP is configured; otherwise accounts
// are auto-verified at creation.
model EmailVerificationToken {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  // When a mail with this link last went out: the same link is sent again
  // while it is valid, and not more often than every two minutes.
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// One-time token emailed to the *new* address to confirm an email change. The
// pending address is stored exactly like User.email* (never plaintext) and only
// promoted onto the User once the link is followed.
model EmailChangeToken {
  id                String    @id @default(uuid())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  newEmailEncrypted String
  newEmailIndex     String
  tokenHash         String    @unique
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId])
}

// ── Profiles ──────────────────────────────────────────────────────────────────

enum Sex {
  male
  female
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum DietType {
  balanced
  high_protein
  low_carb
  vegetarian
  vegan
  keto
  mediterranean
  custom
}

model Profile {
  id                  String        @id @default(uuid())
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  name                String
  age                 Int
  sex                 Sex?
  heightCm            Float
  weightKg            Float
  activityLevel       ActivityLevel @default(moderate)
  dietType            DietType      @default(balanced)
  // "0.25" | "0.5" | "0.75" | "1.0" — null = maintenance.
  weeklyLossTarget    String?
  // When set, overrides the calculated daily calorie target.
  manualCalorieTarget Int?
  // When a profile that is under 18 or underweight said it understands the
  // risk of losing weight. Until then its loss goal is planned as
  // maintenance. Cleared when the profile is no longer either.
  riskAcknowledgedAt  DateTime?
  // The split of a day's energy between protein, fat and carbohydrate that
  // the profile aims at on the custom diet, in whole per cent (`MacroSplit`
  // of the shared contract). A profile on that diet has one.
  customMacroSplit    Json?
  mealCount           Int           @default(3)
  // Transient counter — incremented on every plan-level generation that
  // actually applied the inventory bias. Reset to 0 when it reaches
  // `preferences.inventoryBiasResetEvery` (and the next round skips the bias).
  // Swap-level reranking does NOT touch this column.
  inventoryBiasStreak Int           @default(0)
  // Weight-reminder cadence: 'off' | 'daily' | 'weekly'. Default weekly
  // so a fresh profile gets gentle nudges; constrained at the API layer via
  // WeightReminderCadence in packages/shared.
  weightReminderCadence String   @default("weekly")
  // Last time the worker actually emitted a weight_reminder Notification for
  // this profile. Used as a debounce so a stale-by-one-day profile isn't
  // re-nudged every hourly tick.
  lastWeightReminderAt  DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  preferences   ProfilePreference?
  mealPlans     MealPlan[]
  favorites     Favorite[]
  favoriteSets  FavoriteSet[]
  inventory     InventoryItem[]
  weightEntries WeightEntry[]
  notifications Notification[]

  @@index([userId])
}

// Raw weight log. The dashboard chart, 7-day moving average and the
// reference line against Profile.weightKg are all derived from these rows
// client-side — no precomputed aggregates so a corrected entry is
// instantly reflected.
model WeightEntry {
  id         String   @id @default(uuid())
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  kg         Float
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([profileId, recordedAt(sort: Desc)])
}

// Device-agnostic notification surface. The web client polls
// /notifications/unread; the future Android app reads the same rows after
// an FCM-triggered fetch. `type` is the discriminator, `payload` is
// type-specific context (rendered client-side via the i18n catalogue).
model Notification {
  id        String    @id @default(uuid())
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  // Constrained at the API layer via NotificationType in packages/shared.
  // Currently 'weight_reminder'; future types extend the enum without a
  // migration.
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([profileId, readAt])
  @@index([profileId, createdAt(sort: Desc)])
}

model ProfilePreference {
  id                         String   @id @default(uuid())
  profile                    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId                  String   @unique
  favoriteIngredientIds      String[] @default([])
  excludedIngredientIds      String[] @default([])
  allergens                  String[] @default([])
  dislikedIngredientIds              String[] @default([])
  preferredCuisines          String[] @default([])
  // Hard caps for the meal-plan generator's variety enforcement.
  // See ProfilePreferences zod schema in packages/shared for semantics.
  maxConsecutiveDaysSameMeal Int      @default(2)
  maxTimesPerWeekSameMeal    Int      @default(3)
  // The most of one ingredient, in grams or millilitres, in any seven days.
  maxWeeklyAmountPerIngredient Int    @default(3000)
  // Anti-monotony rotation. After N consecutive inventory-biased plan
  // generations the optimiser drops the pantry bias for the next round and
  // resets the counter, so a long run of leftover-heavy weeks can't lock the
  // user into one recipe corridor. 0 disables the reset entirely.
  inventoryBiasResetEvery    Int      @default(5)
}

// ── Curated product database (SEED DATA — source of truth) ────────────────────

enum ProductCategory {
  vegetables
  fruits
  dairy
  meat
  fish
  grains
  legumes
  nuts_seeds
  fats_oils
  spices
  pantry
  beverages
  other
}

enum Unit {
  g
  ml
  piece
}

// What one piece of an ingredient is called, for the ingredients people count
// instead of weigh. Its weight is the ingredient's `gramsPerPiece`.
enum NaturalUnit {
  piece
  slice
  clove
  handful
}

// Provenance for translation rows. CURATED_JSON rows are derived from
// data/*.json and re-written on every seed; AI / MANUAL rows survive re-seeds
// so operator-generated translations are not lost when curated data is updated.
enum TranslationSource {
  CURATED_JSON
  AI
  MANUAL
}

model Ingredient {
  id                String          @id @default(uuid())
  // Stable kebab-case identifier from data/*.json. Used by the seeder to upsert
  // rows and by the translation tables to join on. Nullable during the
  // migration window; backfilled then enforced by a follow-up migration.
  slug              String?         @unique
  name              String          @unique
  category          ProductCategory
  canonicalUnit     Unit
  // Nutrition per 100 canonical units. NutritionFact mirrors this 1:1 for
  // explicit auditing / alternate serving sizes.
  caloriesPer100    Float
  proteinPer100     Float
  fatPer100         Float
  carbsPer100       Float
  gramsPerPiece     Float?
  density           Float?
  // Set for an ingredient that is counted, not weighed (eggs, slices of bread,
  // cloves of garlic). Curated in the data; needs `gramsPerPiece`. Quantities
  // of it are shown, bought and stocked in pieces. See `engine/display.ts`.
  displayUnit       NaturalUnit?
  allergens         String[]        @default([])
  dietCompatibility String[]        @default([])
  tags              String[]        @default([])
  packSize          Float?
  brand             String?
  storageHint       String?
  // Set when the curated data no longer carries the ingredient but user data
  // still refers to it. A retired ingredient is hidden from search and from
  // every candidate pool; rows that use it keep working. Cleared when the
  // ingredient returns to the data.
  retiredAt         DateTime?

  nutritionFacts       NutritionFact[]
  recipeIngredients    RecipeIngredient[]
  substitutionsFrom    SubstitutionRule[]      @relation("SubFrom")
  substitutionsTo      SubstitutionRule[]      @relation("SubTo")
  translations         IngredientTranslation[]
  ingredientNameDrafts IngredientNameDraft[]
  inventoryItems       InventoryItem[]

  @@index([category])
}

// Per-locale display strings for an Ingredient. Numeric/structural fields stay
// on Ingredient — only user-facing text is localised.
model IngredientTranslation {
  ingredientId String
  locale       String
  name         String
  storageHint  String?
  source       TranslationSource @default(CURATED_JSON)
  updatedAt    DateTime          @updatedAt
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([ingredientId, locale])
  @@index([locale])
  @@index([source])
}

// Explicit nutrition rows — supports alternate serving sizes and audit trail.
model NutritionFact {
  id           String     @id @default(uuid())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String
  servingLabel String // e.g. "per 100 g", "per slice (28 g)"
  servingGrams Float
  calories     Float
  protein      Float
  fat          Float
  carbs        Float

  @@index([ingredientId])
}

model Allergen {
  id    String @id @default(uuid())
  code  String @unique // gluten | dairy | eggs | ...
  label String
}

model SubstitutionRule {
  id               String     @id @default(uuid())
  fromIngredient   Ingredient @relation("SubFrom", fields: [fromIngredientId], references: [id], onDelete: Cascade)
  fromIngredientId String
  toIngredient     Ingredient @relation("SubTo", fields: [toIngredientId], references: [id], onDelete: Cascade)
  toIngredientId   String
  note             String?

  @@unique([fromIngredientId, toIngredientId])
}

// ── Recipes ───────────────────────────────────────────────────────────────────

// Where a recipe came from. `seed` and `curated` recipes are shared, `ai` and
// `user` recipes belong to the user who made them.
enum RecipeOrigin {
  // From the catalogue's data files; an update of the catalogue rewrites it.
  seed
  // A personal recipe a model wrote for its owner.
  ai
  // A personal recipe its owner made, by hand or by swapping an ingredient.
  user
  // Approved in this instance's curation queue and shipped into its own
  // library, whether a batch run or a user wrote it. An update of the
  // catalogue leaves it alone; the instance's data directory holds its copy.
  curated
}

enum Difficulty {
  easy
  medium
  hard
}

model Recipe {
  id                 String       @id @default(uuid())
  // Stable kebab-case identifier for seed-origin recipes; null for user/AI
  // recipes. Used by the seeder + translation tables, same role as Ingredient.slug.
  slug               String?      @unique
  title              String
  description        String
  servings           Int
  mealTypes          String[]     @default([])
  dietTags           String[]     @default([])
  steps              String[]     @default([])
  prepMinutes        Int
  cookMinutes        Int
  difficulty         Difficulty   @default(easy)
  // The cuisine the recipe belongs to (`Cuisine` of the shared contract), when
  // it belongs to one. The planner leans towards the cuisines a profile prefers.
  cuisine            String?
  allergens          String[]     @default([])
  origin             RecipeOrigin @default(seed)
  // A model had a part in this recipe of a user's: it chose the ingredient
  // that was swapped in, or reworded the text around it. A recipe a model
  // wrote whole says so by its origin.
  modelAssisted      Boolean      @default(false)
  // Per-serving nutrition — DERIVED from ingredients, recomputed on write.
  caloriesPerServing Float        @default(0)
  proteinPerServing  Float        @default(0)
  fatPerServing      Float        @default(0)
  carbsPerServing    Float        @default(0)
  reuseScore         Float        @default(0)
  // The account a personal recipe belongs to; null for a recipe of the shared
  // library. A personal recipe goes with its account.
  createdBy          User?        @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdByUserId    String?
  // A stable name for what the recipe is made of (see admin/drafts/fingerprint.ts),
  // unique per owner: two users may each own the same recipe, one user owns it
  // once. Null while an ingredient has no slug, and on rows written before the
  // fingerprint took its present form; the catalogue update fills those in.
  fingerprint        String?
  // Soft-delete column. Users can delete their own AI/swap-variant recipes
  // without breaking planned meals that already reference the row. Set by
  // DELETE /recipes/:id; every user-facing list filters `deletedAt IS NULL`.
  deletedAt          DateTime?
  // Set when the curated data no longer carries the recipe but a plan, a
  // favourite or a favourite set still refers to it. A retired recipe is
  // hidden from the library and from every candidate pool; the rows that use
  // it keep working. Cleared when the recipe returns to the data.
  retiredAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  ingredients  RecipeIngredient[]
  plannedMeals PlannedMeal[]
  favorites    Favorite[]
  translations RecipeTranslation[]

  @@unique([createdByUserId, fingerprint])
  @@index([fingerprint])
  @@index([origin])
  @@index([createdByUserId, deletedAt])
}

// Per-locale display strings for a Recipe. `steps` is an array because recipe
// steps are an ordered list and translating each step in place is more accurate
// than translating one concatenated blob.
model RecipeTranslation {
  recipeId    String
  locale      String
  title       String
  description String
  steps       String[]          @default([])
  source      TranslationSource @default(CURATED_JSON)
  updatedAt   DateTime          @updatedAt
  recipe      Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, locale])
  @@index([locale])
  @@index([source])
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId     String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String
  quantity     Float
  unit         Unit
  note         String?

  @@index([recipeId])
  @@index([ingredientId])
}

// ── Meal plans ────────────────────────────────────────────────────────────────

enum GenerationMode {
  deterministic
  ai_assisted
}

model MealPlan {
  id             String         @id @default(uuid())
  profile        Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId      String
  startDate      DateTime       @db.Date
  durationDays   Int
  dietType       DietType
  calorieTarget  Int
  // The split a plan on the custom diet aims at, as the profile had it when
  // the plan was made (`MacroSplit`); null on every other diet.
  macroSplit     Json?
  generationMode GenerationMode @default(deterministic)
  reuseScore     Float          @default(0)
  // What the plan was asked for (`PlanOptions` of the shared contract): what
  // making it again, and changing a meal of it, goes by.
  options        Json
  // The random value the choices of its last generation were drawn with.
  seed           Int
  // What its generation had to do (`StoredReport` in the plan service): the
  // limits that gave way and for which recipe, the meals with one recipe to
  // choose from, what the pantry had to do with it. Null on a plan made before
  // this was kept.
  report         Json?
  // Counts the changes made to the plan. A change is written only if the
  // revision is still the one it was computed from, so two requests that
  // overlap cannot both rewrite the plan.
  revision       Int            @default(0)
  createdAt      DateTime       @default(now())

  days          MealPlanDay[]
  shoppingLists ShoppingList[]

  @@index([profileId])
}

model MealPlanDay {
  id            String   @id @default(uuid())
  plan          MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId        String
  date          DateTime @db.Date
  // The resolved per-day calorie target. The advanced per-day override
  // (when set) lands here, so swap, favorite-set apply and the rebalancer read
  // it unchanged.
  calorieTarget Int
  // Raw advanced inputs + semantics for this day:
  // { mealCount?, dayType?, skip?, cookTimeBudgetMinutes?, useUpBy?, lockedSlots? }.
  // Null = no advanced options (basic flow). `regenerate*` re-applies these;
  // the rebalancer reads `dayType`; the DTO surfaces them to the UI.
  overrides     Json?

  meals PlannedMeal[]

  @@unique([planId, date])
}

model PlannedMeal {
  id          String      @id @default(uuid())
  day         MealPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId       String
  // Optional: user-authored custom meals carry no catalogue recipe. A
  // recipe that a plan still uses cannot be deleted.
  recipe      Recipe?     @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  recipeId    String?
  mealType    String
  // The optimiser/swap baseline portion ("1 serving of recipe X").
  servings    Float       @default(1)
  // Recipe ids previously shown in this slot via the "swap meal" action.
  // The swap picker excludes the union of this array + the current recipeId
  // so repeated clicks advance through fresh candidates instead of cycling
  // between two. Cleared (reset to just the current recipeId) when the pool
  // is exhausted.
  swapHistory String[]    @default([])
  // Flexible meal plans:
  // `source` distinguishes a catalogue meal from a user-authored custom meal.
  source      PlannedMealSource @default(CATALOGUE)
  // Custom meals (source=USER_CUSTOM) have no Recipe row; their name + frozen,
  // user-entered macros { calories, protein, fat, carbs } live on the row.
  customName  String?
  customMacros Json?
  // Mark-eaten: a checked meal is pinned (excluded from the rebalance set).
  eatenAt     DateTime?
  // Rebalancer multiplier on top of `servings`. Effective amount = servings *
  // quantityScale. Default 1.0 = untouched. Nutrition and
  // shopping-list quantities read the product of the two.
  quantityScale Float     @default(1.0)
  lastRebalanceAt DateTime?
  // A model chose this recipe for the meal, out of what the engine allowed,
  // and this is the reason it gave, when it gave one. Cleared when the meal
  // gets another recipe any other way.
  modelPicked Boolean     @default(false)
  modelReason String?

  @@index([dayId])
  // Cross-plan "which meals use recipe X" lookups (cascade checks, future
  // reporting) would otherwise full-scan PlannedMeal.
  @@index([recipeId])
}

enum PlannedMealSource {
  CATALOGUE
  USER_CUSTOM
}

// ── Favorites ─────────────────────────────────────────────────────────────────

model Favorite {
  id        String   @id @default(uuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String
  tags      String[] @default([])
  // user preference signal: often used vs. avoid
  sentiment String   @default("favorite") // favorite | often | avoid
  createdAt DateTime @default(now())

  @@unique([profileId, recipeId])
  @@index([profileId])
}

// Per-profile saved day template — one favourited recipe per meal slot.
// `slots` is a loose JSON map `{ [mealType]: recipeId }` validated against the
// recipe table at apply-time; storing recipe ids in JSON instead of a join
// table keeps reads to one row and applies symmetric with the meal-plan day
// shape the optimiser writes.
model FavoriteSet {
  id        String   @id @default(uuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  label     String
  slots     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// ── Inventory (pantry-aware planning) ─────────────────────────────────────

// Per-profile stock of ingredients the user actually has, kept by hand. The
// one thing that changes it for the user is a shopping list: ticking a row off
// takes what the list counted as already at home and adds what was bought
// beyond the need (see `ShoppingListItem.pantryMoves`). Marking a meal eaten
// changes nothing here. Plan generation, day re-roll and meal swap lean toward
// recipes the pantry can cover; see `engine/optimizer.ts`.
//
// A quantity is stored in the `unit` it was entered in (g / ml / piece), one
// row per `(profile, ingredient, unit)`: six eggs as pieces next to 200 g of
// egg white as grams. Everything that reads or changes the stock of an
// ingredient adds its rows up in the canonical unit through `engine/pantry.ts`.
model InventoryItem {
  id           String     @id @default(uuid())
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  // Restrict: removing an ingredient must never take a user's stock with it.
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientId String
  quantity     Float
  unit         Unit
  bestBefore   DateTime?  @db.Date
  // Optional free-form note (e.g. "leftover from Sunday roast"). Never sent
  // to AI prompts; this column is read by the inventory page only.
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([profileId, ingredientId, unit])
  @@index([profileId])
  @@index([profileId, ingredientId])
}

// ── Shopping lists ────────────────────────────────────────────────────────────

model ShoppingList {
  id        String   @id @default(uuid())
  plan      MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId    String
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  createdAt DateTime @default(now())

  items ShoppingListItem[]

  @@index([planId])
}

model ShoppingListItem {
  id                    String          @id @default(uuid())
  list                  ShoppingList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId                String
  ingredientId          String
  name                  String
  category              ProductCategory
  totalQuantity         Float
  unit                  Unit
  // What the list took as already at home when it was made: the pantry's
  // stock less the open claims of the profile's other lists. Never changes.
  alreadyHaveQuantity   Float           @default(0)
  // Everything the user has for this row, the part already at home included.
  // Null until first edit. The row ticks itself (`checked = true`) when this
  // reaches `totalQuantity`. While it is ticked the row's net effect on the
  // pantry is meant to be
  //   max(0, purchasedQuantity - totalQuantity) - alreadyHaveQuantity
  // in the row's unit: the surplus enters the pantry, what was counted as
  // already at home leaves it.
  purchasedQuantity     Float?
  // What the row has actually done to the pantry: a list of
  // `{ unit, quantity, bestBefore? }`, one entry per pantry row it changed,
  // negative for what it took. It records the effect, not the intent: when
  // the pantry held less than the row counted on, less was taken. Undoing the
  // row gives back exactly these moves. Written by `engine/pantry.ts` only.
  pantryMoves           Json            @default("[]")
  // Snapshot of the earliest best-before across pantry rows that contributed
  // to `alreadyHaveQuantity`. Surfaced on the "from pantry" chip so the user
  // sees urgency while shopping. Null when there was no pantry contribution or
  // the contributing rows had no expiry.
  pantryBestBefore      DateTime?
  estimatedCalories     Float           @default(0)
  checked               Boolean         @default(false)

  @@index([listId])
}

// ── AI configuration & observability ──────────────────────────────────────────

enum AiProviderKind {
  openai
  anthropic
  openrouter
  ollama
}

model AiProviderConfig {
  id             String         @id @default(uuid())
  // Null userId = admin-level default available to everyone.
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  provider       AiProviderKind
  model          String
  // AES-256-GCM ciphertext (iv:tag:data); never returned by the API.
  encryptedKey   String?
  // Per-config base URL — only meaningful for self-hosted Ollama instances.
  // Required at the API layer when provider = ollama (the user picks the host
  // explicitly). Other providers ignore it.
  baseUrl        String?
  priority       Int            @default(0)
  enabled        Boolean        @default(true)
  isAdminDefault Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // One configuration of a provider for an account: saving it again changes it.
  @@unique([userId, provider])
}

// How a call to a provider ended. A row starts as PENDING, before the provider
// is asked, and is settled when the provider returns.
enum AiCallOutcome {
  PENDING
  COMPLETED // the provider answered, whether or not the answer was usable
  FAILED // the provider refused, errored or could not be reached
  TIMED_OUT
}

model AiUsageLog {
  id           String        @id @default(uuid())
  // A call belongs to the account that made it, and goes with it. What the
  // calls of a deleted account still count for is kept by day, without the
  // account, in AiUsageOfDeletedAccounts.
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  provider     String
  model        String
  operation    String // recipe-draft | meal-swap | ingredient-swap | swap-rewrite
  // Who pays for the call: 'admin' is the operator's provider, whose calls
  // count against the monthly allowance; 'byok' is the user's own. Null on
  // rows logged before the mode was recorded.
  mode         String?
  // Only COMPLETED calls, and PENDING ones still in flight, count against an
  // allowance: a call the provider never completed was not paid for.
  outcome      AiCallOutcome
  promptTokens Int           @default(0)
  outputTokens Int           @default(0)
  latencyMs    Int           @default(0)
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([userId, mode, createdAt])
}

// Completed calls to the operator's provider that accounts made before they
// were deleted, by the day they were made. The usage log of an account goes
// with it; what those calls count for in the instance's monthly allowance
// stays here, with nothing that says whose they were.
model AiUsageOfDeletedAccounts {
  day   DateTime @id @db.Date
  calls Int
}

// ── Curation queue (drafts) ───────────────────────────────────────────────────

// A model or a user proposes, people approve, and what is approved ships: into
// this instance's own tables, into a file, or into a pull request. A draft is
// no recipe: nothing plans with it until it has shipped.

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
}

enum DraftSource {
  AI
  EXTERNAL
  MANUAL
  // Personal Recipe written by /recipes/ai-draft or applyIngredientSwap,
  // mirrored into the queue for translation polish + optional promotion to
  // curated. Reviewer can edit translations only; admin alone can promote.
  AI_USER
}

model RecipeDraft {
  id                 String      @id @default(uuid())
  slug               String
  // Locale-keyed JSON: { "en": "Chicken curry", "pl": "Curry z kurczaka" }.
  // The shape data/recipes.json has; a ship writes one RecipeTranslation row
  // per language.
  titles             Json
  descriptions       Json
  // Same locale keys; values are string[]: { "en": ["Step 1"], "pl": ["Krok 1"] }.
  steps              Json
  // Locales this draft was generated in / is expected to ship with. Derived
  // from the generation spec's targetLocales; the reviewer-locale gate
  // enforces this.
  locales            String[]
  servings           Int
  mealTypes          String[]    @default([])
  dietTags           String[]    @default([])
  prepMinutes        Int
  cookMinutes        Int
  difficulty         Difficulty  @default(easy)
  // The cuisine the recipe will be tagged with when it ships, if any.
  cuisine            String?
  // 'simple' | 'medium' | 'complex': the band the count of ingredients and
  // steps and the total time put the recipe in.
  complexity         String      @default("medium")
  // Engine-recomputed values — never the AI's. See engine/units.ts +
  // engine/nutrition.ts.
  caloriesPerServing Float       @default(0)
  proteinPerServing  Float       @default(0)
  fatPerServing      Float       @default(0)
  carbsPerServing    Float       @default(0)
  allergens          String[]    @default([])
  // [{ slug, quantity, unit, note? }]
  ingredientsJson    Json
  // Derived from the reviews that count now: APPROVED iff every locale in
  // `locales[]` has an APPROVE row; REJECTED if any has a REJECT; PENDING
  // otherwise. SHIPPED is set by a ship only.
  status             DraftStatus @default(PENDING)
  source             DraftSource @default(AI)
  batchId            String
  modelUsed          String?
  generatorPrompt    String?
  generationSpec     Json?
  // EXTERNAL only — source URL + license for the imported row.
  provenanceUrl      String?
  provenanceLicense  String?
  shippedPRUrl       String?
  shippedAt          DateTime?
  // The fingerprint of the recipe the draft describes (see
  // admin/drafts/fingerprint.ts): one draft per recipe, however many personal
  // recipes it stands for. Null on drafts of an admin batch.
  fingerprint        String?     @unique
  // The personal recipes this draft stands for: the one its owner submitted,
  // or those of the users who each made the same recipe. The draft itself
  // names no user.
  sourceRecipeIds    String[]    @default([])
  // The recipe of the shared library this draft became, when it shipped into
  // this instance's own tables.
  promotedRecipeId   String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  localeReviews RecipeDraftLocaleReview[]

  @@index([status])
  @@index([batchId])
  @@index([source])
}

// Who wrote a review: the administrator, or a reviewer signed in with the
// shared reviewer password.
enum ReviewerRole {
  ADMIN
  REVIEWER
}

model RecipeDraftLocaleReview {
  id              String        @id @default(uuid())
  draft           RecipeDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId         String
  // ISO 639-1; constrained to the Locale enum at the API layer.
  locale          String
  // 'APPROVE' | 'REJECT' — constrained at the API layer.
  action          String
  // Null on a row written before the role was recorded.
  byRole          ReviewerRole?
  // The name the reviewer signed in with, or the one the administrator gave
  // (e.g. "Anna", "PL-reviewer-1").
  reviewedByLabel String
  reason          String?
  reviewedAt      DateTime      @default(now())
  // Set when a later review of the same language, or an edit of the draft,
  // took this row's place. The review a language has now is the row where
  // this is null; the others are the record of what was decided before, and
  // are never deleted while the draft exists. One current row per language is
  // kept by the lock every writer takes on the draft, not by an index.
  supersededAt    DateTime?

  @@index([draftId, locale])
}

model IngredientNameDraft {
  id              String      @id @default(uuid())
  // Nullable so a draft survives ingredient deletion for audit. The seeder
  // resolves overrides by `ingredientSlug` on ship.
  ingredient      Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  ingredientId    String?
  ingredientSlug  String
  // FDC description at draft time — read-only source reference.
  rawDescription  String
  // Locale-keyed JSON: { "name": { "en": "Beef tenderloin", "pl": "Polędwica wołowa" },
  //                      "storageHint"?: { "en": "...", "pl": "..." } }.
  suggestions     Json
  locales         String[]
  status          DraftStatus @default(PENDING)
  source          DraftSource @default(AI)
  batchId         String
  modelUsed       String?
  // Prompt version tag, e.g. "ingredient-namer.v1".
  generatorPrompt String?
  shippedPRUrl    String?
  shippedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  localeReviews IngredientNameDraftLocaleReview[]

  @@index([status])
  @@index([batchId])
  @@index([ingredientSlug])
}

// The same record as RecipeDraftLocaleReview, for the name of an ingredient.
model IngredientNameDraftLocaleReview {
  id              String              @id @default(uuid())
  draft           IngredientNameDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId         String
  locale          String
  action          String
  byRole          ReviewerRole?
  reviewedByLabel String
  reason          String?
  reviewedAt      DateTime            @default(now())
  supersededAt    DateTime?

  @@index([draftId, locale])
}

// Where a background job of the administrator's stands (an update of the
// catalogue, an import, a run that writes drafts): read by whichever process
// of the API is asked, written by the one that runs the job.
model JobState {
  name          String   @id
  state         Json
  // Moved while the job runs. A job that says it runs and has not moved this
  // for a while stopped with its process.
  heartbeatAt   DateTime
  // Asked of the process that runs the job, in whichever process it was asked.
  stopRequested Boolean  @default(false)
}

// Singleton runtime configuration owned by the operator and managed from
// /admin. Carries the reviewer-interface toggle and its password hash.
model InstanceSettings {
  id                   String   @id @default("singleton")
  reviewerEnabled      Boolean  @default(false)
  // Hashed as the passwords of accounts are; null when the operator cleared it.
  reviewerPasswordHash String?
  // Raised when the password changes and when the panel is closed. A
  // reviewer's session says which epoch it is of, and one of an earlier
  // epoch is no session: it ends then, and does not come back.
  reviewerSessionEpoch Int      @default(0)
  // Raised when the administrator ends every admin session: one of an
  // earlier epoch is none.
  adminSessionEpoch    Int      @default(0)
  updatedAt            DateTime @updatedAt
}

// ── Seed bookkeeping ──────────────────────────────────────────────────────────

// Tracks the curated DB version that last ran through the seeder. A single
// row keyed by 'data'; `hash` is sha256 of the concatenated seed files. The
// /admin DB-update flow uses it to surface "update available" when the current
// hash of data/*.json differs from what's stored.
model SeedMeta {
  key           String   @id
  hash          String
  seededAt      DateTime
  // Counters captured at the moment of the last successful seed — cheap to
  // surface without re-counting tables on every stats request.
  ingredients   Int      @default(0)
  recipes       Int      @default(0)
  substitutions Int      @default(0)
}
