{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      // `start:worker` runs the built `dist/worker.js`; declare the source so
      // knip doesn't report the scheduled-tasks entrypoint as an unused file.
      "entry": ["src/main.ts", "src/worker.ts", "scripts/*.ts"],
    },
    "apps/web": {
      // The icon script is run by hand: nothing imports it.
      "entry": [
        "src/app/**/{page,layout,loading,error,not-found,route,template,default}.tsx",
        "scripts/make-icons.mjs",
      ],
      // The icon script draws with the image library the framework brings for its own pictures.
      "ignoreDependencies": ["sharp"],
    },
  },
}
